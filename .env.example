# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# GTM is loaded only when this variable is set. Do not hardcode a container ID.
# Configure GA4, Meta, and Pinterest as tags inside GTM — not in this codebase.
NEXT_PUBLIC_GTM_ID=

# Inquiry form (Brevo). Already used by /api/inquiry.
BREVO_API_KEY=
BREVO_LIST_ID=
NOTIFICATION_EMAIL=
